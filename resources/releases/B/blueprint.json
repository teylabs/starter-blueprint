{
  "format": 1,
  "id": "teylabs/private-workspace",
  "version": "0.2.0",
  "groups": [
    "workspace-foundation"
  ],
  "requirements": {
    "php": "~8.4.0 || ~8.5.0",
    "laravel/framework": "^13.17",
    "tey/mod": "^0.7.2",
    "tey/concierge": "0.7.1",
    "spatie/laravel-multitenancy": "^4.2",
    "spatie/laravel-settings": "^3.9",
    "laravel/pennant": "^1.0",
    "laravel/mcp": "^1.0"
  },
  "generated": {
    "app/Support/Starter/BlueprintPolicy.php": {
      "stub": "policy.php.stub",
      "scaffold": "starter-foundation",
      "ownership": "generated"
    }
  },
  "host_owned": [
    "config/branding.php",
    "app/Domain",
    "config/starter-bindings.php",
    "database"
  ],
  "migration_order": [
    "host identity/workspace tables",
    "permission team schema",
    "Concierge membership/invitation schema",
    "host workspace settings and example feature"
  ],
  "verification": [
    "dependency compatibility",
    "generated resource integrity",
    "host operation and tenant acceptance"
  ],
  "auth": {
    "browser": "session authentication; closed registration",
    "mcp": "delegated OAuth2 protocol binding required; no synthetic actor bypass"
  },
  "exceptions": []
}
